{
  "name": "mortar",
  "version": "1.0.1",
  "description": "A Claude Code client for Roblox Studio",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "author": "flumzee",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "pack": "electron-builder --win --dir"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.226"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "lucide-static": "^1.31.0"
  },
  "build": {
    "appId": "com.flumzee.mortar",
    "productName": "Mortar",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@anthropic-ai/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "Mortar-${version}-${arch}.dmg"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "flumzee",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "Mortar-${version}-portable.AppImage"
    },
    "deb": {
      "artifactName": "Mortar-${version}-${arch}.deb"
    },
    "nsis": {
      "artifactName": "Mortar-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mortar"
    },
    "portable": {
      "artifactName": "Mortar-${version}-portable.exe"
    }
  }
}
