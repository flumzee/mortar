{
  "name": "mortar",
  "version": "1.0.0",
  "description": "A Claude Code client for Roblox Studio",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "author": "flumzee",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.226"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "lucide-static": "^1.31.0"
  },
  "build": {
    "appId": "com.flumzee.mortar",
    "productName": "Mortar",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@anthropic-ai/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mortar"
    },
    "portable": {
      "artifactName": "Mortar-${version}-portable.exe"
    }
  }
}
